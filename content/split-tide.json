  "locations": [
    {
      "id": "lowsail.checkpoint",
      "name": "Lowsail Checkpoint",
      "description": "A red flag hangs over the checkpoint. Sava guards the only dry path to Lowsail Market.",
      "exits": ["lowsail.docks", "lowsail.levee"],
      "terminal": false
    },
    {
      "id": "lowsail.docks",
      "name": "Lowsail Docks",
      "description": "Boats knock against the docks. Oren watches a courier skiff beside a locked tide chest.",
      "exits": ["lowsail.checkpoint", "lowsail.levee", "lowsail.return"],
      "terminal": false
    },
    {
      "id": "lowsail.levee",
      "name": "Lowsail Levee",
      "description": "The levee road runs east to the Sluice. Flood marks show fresh damage.",
      "exits": ["lowsail.checkpoint", "red_sluice.floor"],
      "terminal": false
    },
    {
      "id": "red_sluice.floor",
      "name": "Red Sluice Floor",
      "description": "Water pounds the lower gate. Edrik holds a broken gauge above the intake.",
      "exits": ["lowsail.levee", "red_sluice.top"],
      "terminal": false
    },
    {
      "id": "red_sluice.top",
      "name": "Red Sluice Top",
      "description": "Mira waits beside the control wheels. A hot service ladder climbs into steam.",
      "exits": ["red_sluice.floor", "lowsail.return"],
      "terminal": false
    },
    {
      "id": "lowsail.return",
      "name": "Lowsail Return",
      "description": "The water has changed the market. Stalls, prices, and guards show who controls the tide.",
      "exits": ["lowsail.docks", "red_sluice.top"],
      "terminal": false
    }
  ],
